{
  "name": "@spc/db",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test ./src/tests/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:fixtures": "node --import tsx ./src/seeds/run-fixture-seed.ts",
    "test:fixtures": "DATABASE_URL=${DATABASE_URL:-postgres://postgres:postgres@localhost:5432/spc} node --import tsx --test ./src/tests/fixture-validation.test.ts"
  },
  "dependencies": {
    "@spc/test-fixtures": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
