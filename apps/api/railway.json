{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npx pnpm --filter @spc/api build"
  },
  "deploy": {
    "preDeployCommand": "npx pnpm db:migrate",
    "startCommand": "npx pnpm --filter @spc/api start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  },
  "watchPatterns": [
    "/apps/api/**",
    "/packages/application/**",
    "/packages/db/**",
    "/packages/domain/**",
    "/packages/test-fixtures/**",
    "/package.json",
    "/pnpm-lock.yaml",
    "/pnpm-workspace.yaml",
    "/tsconfig.base.json",
    "/turbo.json"
  ]
}
