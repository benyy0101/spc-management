{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npx pnpm --filter @spc/web build"
  },
  "deploy": {
    "startCommand": "npx pnpm --filter @spc/web start",
    "restartPolicyType": "ON_FAILURE"
  },
  "watchPatterns": [
    "/apps/web/**",
    "/package.json",
    "/pnpm-lock.yaml",
    "/pnpm-workspace.yaml",
    "/tsconfig.base.json",
    "/turbo.json"
  ]
}
